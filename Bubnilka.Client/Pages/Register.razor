@page "/register"
@layout Shared.LoginLayout
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@using Bubnilka.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms

<h2>Регистрация</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-message">@errorMessage</div>
}

@if (successMessage != null)
{
    <div class="success-message">@successMessage</div>
}

<EditForm Model="registerRequest" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    
    <div class="form-group">
        <label for="email">Email</label>
        <InputText id="email" @bind-Value="registerRequest.Email" class="form-control" placeholder="your@email.com" />
        <ValidationMessage For="@(() => registerRequest.Email)" />
    </div>

    <div class="form-group">
        <label for="displayName">Отображаемое имя (необязательно)</label>
        <InputText id="displayName" @bind-Value="registerRequest.DisplayName" class="form-control" placeholder="Ваше имя" />
        <ValidationMessage For="@(() => registerRequest.DisplayName)" />
    </div>

    <div class="form-group">
        <label for="password">Пароль</label>
        <InputText id="password" type="password" @bind-Value="registerRequest.Password" class="form-control" placeholder="Минимум 8 символов" />
        <ValidationMessage For="@(() => registerRequest.Password)" />
    </div>

    <div class="form-group">
        <label for="confirmPassword">Подтверждение пароля</label>
        <InputText id="confirmPassword" type="password" @bind-Value="registerRequest.ConfirmPassword" class="form-control" placeholder="Повторите пароль" />
        <ValidationMessage For="@(() => registerRequest.ConfirmPassword)" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isLoading">
        @if (isLoading)
        {
            <span>Регистрация...</span>
        }
        else
        {
            <span>Зарегистрироваться</span>
        }
    </button>
</EditForm>

<div class="switch-auth">
    Уже есть аккаунт? <a href="/login">Войти</a>
</div>

@code {
    private RegisterRequest registerRequest = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/chats");
        }
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var result = await AuthService.Register(
                registerRequest.Email,
                registerRequest.Password,
                registerRequest.ConfirmPassword,
                registerRequest.DisplayName);

            if (result.Success)
            {
                successMessage = "Регистрация успешна! Перенаправление...";
                await Task.Delay(1000);
                NavigationManager.NavigateTo("/chats");
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Ошибка регистрации";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка соединения: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
